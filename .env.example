# Neon Postgres. `neon deploy` (or `neon env pull`) fills these in.
DATABASE_URL=""            # pooled: used by the app
DATABASE_URL_UNPOOLED=""   # direct: used by prisma migrate / studio

# Better Auth: at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# First administrator, created by npm run db:seed
SEED_ADMIN_NAME="Shop Owner"
SEED_ADMIN_EMAIL="owner@buntrack.test"
SEED_ADMIN_PASSWORD=""
